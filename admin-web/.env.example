# Copy to .env and fill in the values of the "Traveler admin" OIDC application
# from authentik. Vite reads these when the dev server starts and when the app
# is built, so restart or rebuild after changing them.
# Nothing here is a real value.

# Issuer URL of the authentik application (it serves /.well-known/openid-configuration).
VITE_OIDC_AUTHORITY=https://authentik.example.invalid/application/o/your-application-slug/

# Client ID of the application. It is public, there is no client secret.
VITE_OIDC_CLIENT_ID=your-client-id

# Where authentik sends the browser after sign-in. The path must be /auth/callback.
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# Where authentik sends the browser after sign-out.
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login

# Scopes to request, separated by spaces.
VITE_OIDC_SCOPE=openid profile email

# Development only: where `npm run dev` and `npm run preview` forward the
# app's /admin/... requests, that is the admin backend. Defaults to
# http://localhost:8080 when not set.
VITE_ADMIN_API_PROXY_TARGET=http://localhost:8080
