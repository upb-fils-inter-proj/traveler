# Copy to .env and replace every change-me. The real .env is never committed.

TOURIST_DB_PASSWORD=change-me
ADMIN_DB_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Image tag of both backends. The deployment sets it to the commit it deploys.
IMAGE_TAG=latest

# Public gateways. Each one needs a certificate and key in tourist/ and admin/
# under CERTS_DIR (fullchain.pem and privkey.pem). The two gateways share one
# host, so they listen on different ports.
# CERTS_DIR defaults to ./certs. On the server it is outside the checkout.
# CERTS_DIR=/opt/traveler/certs
TOURIST_SERVER_NAME=tourist.example.test
ADMIN_SERVER_NAME=admin.example.test
TOURIST_HTTPS_PORT=443
ADMIN_HTTPS_PORT=8443

# Requests per client address, in the Nginx rate format.
TOURIST_RATE_LIMIT=10r/s
ADMIN_RATE_LIMIT=10r/s

# authentik. The names are the ones the authentik documentation uses.
# PG_PASS is the password of authentik's own database. Generate both values with:
#   openssl rand -base64 36 | tr -d '\n'     (PG_PASS)
#   openssl rand -base64 60 | tr -d '\n'     (AUTHENTIK_SECRET_KEY)
# Changing AUTHENTIK_SECRET_KEY later signs everyone out.
PG_PASS=change-me
AUTHENTIK_SECRET_KEY=change-me

# The akadmin account, created on the very first start only. Changing these
# later changes nothing: change the password in authentik instead.
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_EMAIL=change-me@example.test

# Plain HTTP port of authentik. Put HTTPS in front of it (the tunnel does).
AUTHENTIK_HTTP_PORT=9000

# Redirect URIs of the Traveler applications in authentik (see DEPLOY.md).
# ADMIN_WEB_URL is where the admin web app is hosted, without a trailing slash.
# TRAVELER_APP_REDIRECT_URI is set by the mobile app work (EN-05); until then
# it stays a placeholder.
ADMIN_WEB_URL=https://admin-web.example.test
TRAVELER_APP_REDIRECT_URI=https://placeholder.example.invalid/set-by-en-05

# Public address of authentik (the Cloudflare route), without a trailing slash.
AUTHENTIK_PUBLIC_URL=https://auth.example.test

# Signs the QR codes of the attractions: an Ed25519 private key, PKCS#8 DER in base64.
#   openssl genpkey -algorithm ed25519 -outform DER | base64 -w0
TRAVELER_QR_PRIVATE_KEY=change-me

# Object storage (RustFS) for attraction photos. Generate the keys with
#   openssl rand -hex 16   and   openssl rand -hex 32
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_BUCKET=traveler
