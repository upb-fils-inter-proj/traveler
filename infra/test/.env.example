# Copy to .env and replace every change-me. The real .env is never committed.

TOURIST_DB_PASSWORD=change-me
ADMIN_DB_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Image tag of both backends. The deployment sets it to the commit it deploys.
IMAGE_TAG=latest

# Public gateways. Each one needs a certificate and key in certs/tourist and
# certs/admin (fullchain.pem and privkey.pem). The two gateways share one host,
# so they listen on different ports.
TOURIST_SERVER_NAME=tourist.example.test
ADMIN_SERVER_NAME=admin.example.test
TOURIST_HTTPS_PORT=443
ADMIN_HTTPS_PORT=8443

# Requests per client address, in the Nginx rate format.
TOURIST_RATE_LIMIT=10r/s
ADMIN_RATE_LIMIT=10r/s
